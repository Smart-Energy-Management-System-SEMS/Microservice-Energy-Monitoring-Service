# Azure Container Apps example overrides
PORT=<container-app-port>
MONGODB_URI=<mongodb-connection-string>
KAFKA_BROKERS=<event-hubs-namespace>.servicebus.windows.net:9093
ALLOWED_ORIGINS=<https://your-frontend.example.com,https://another-origin.example.com>
CONFIG_SERVICE_URL=<https://your-config-service.example.com>
KAFKA_TOPIC_DEVICE_EVENTS=device.events
KAFKA_TOPIC_ENERGY_EVENTS=energy.events
KAFKA_TOPIC_ANALYTICS_EVENTS=analytics.events
KAFKA_TOPIC_ALERTS_EVENTS=alerts.events
KAFKA_ENABLE_TOPIC_INIT=false

# Kafka security settings for Azure Event Hubs
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=$ConnectionString
KAFKA_PASSWORD=Endpoint=sb://<event-hubs-namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy-name>;SharedAccessKey=<policy-key>
