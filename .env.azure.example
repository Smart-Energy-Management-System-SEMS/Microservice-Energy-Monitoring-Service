# Azure Container Apps example overrides
PORT=<container-app-port>
MONGODB_URI=<mongodb-connection-string>
KAFKA_BROKERS=<kafka-bootstrap-host:9092>
ALLOWED_ORIGINS=<https://your-frontend.example.com,https://another-origin.example.com>
CONFIG_SERVICE_URL=<https://your-config-service.example.com>

# Kafka security settings for Event Hubs, Aiven, or secured Kafka clusters
KAFKA_SECURITY_PROTOCOL=<SASL_SSL>
KAFKA_SASL_MECHANISM=<PLAIN>
KAFKA_USERNAME=<$ConnectionString-or-username>
KAFKA_PASSWORD=<connection-string-or-password>
