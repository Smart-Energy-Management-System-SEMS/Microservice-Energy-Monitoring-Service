SERVICE_NAME=energy-monitoring-service
PORT=8080
CONFIG_SERVICE_URL=
# Container-to-container default. For Azure Event Hubs use <namespace>.servicebus.windows.net:9093
KAFKA_BROKERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
DATABASE_URL=
MONGODB_URI=mongodb://mongodb:27017
ENVIRONMENT=production

# Variables currently used by the service (local fallback if Config Service is unavailable)
MONGODB_DATABASE=energy_monitoring_db
KAFKA_GROUP_ID=energy-monitoring-group
KAFKA_TOPIC_DEVICE_EVENTS=device.events
KAFKA_TOPIC_ENERGY_EVENTS=energy.events
KAFKA_TOPIC_ANALYTICS_EVENTS=analytics.events
KAFKA_TOPIC_ALERTS_EVENTS=alerts.events
KAFKA_ENABLE_TOPIC_INIT=true
DEVICE_SIMULATION_INTERVAL_SECONDS=3600
APP_HOST=0.0.0.0
API_BASE_PATH=/api/v1
CORS_ALLOW_ORIGINS=https://frontend.example.com

# Legacy compatibility aliases (optional)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
MONGODB_URL=
APP_PORT=
APP_ENV=
KAFKA_TOPIC_MONITORING_READING_INGEST=
KAFKA_TOPIC_READING_INGEST=
KAFKA_TOPIC_ANALYTICS_ANOMALY_DETECTED=
KAFKA_TOPIC_ANOMALY_DETECTED=
KAFKA_TOPIC_MONITORING_ALERT_CREATED=
KAFKA_TOPIC_ALERT_CREATED=
KAFKA_TOPIC_MONITORING_READING_PROCESSED=
KAFKA_TOPIC_READING_PROCESSED=
