SERVICE_NAME=energy-monitoring-service
PORT=8080
CONFIG_SERVICE_URL=
# Local run (Python app on host + Kafka in docker-compose): localhost:29092
# Container-to-container (Python app in docker-compose + Kafka in docker-compose): kafka:9092
KAFKA_BROKERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
DATABASE_URL=
MONGODB_URI=
ENVIRONMENT=production

# Variables currently used by the service (local fallback if Config Service is unavailable)
MONGODB_DATABASE=energy_monitoring_db
KAFKA_GROUP_ID=energy-monitoring-group
KAFKA_TOPIC_MONITORING_READING_INGEST=monitoring.reading.ingest
KAFKA_TOPIC_ANALYTICS_ANOMALY_DETECTED=analytics.anomaly.detected
KAFKA_TOPIC_DEVICE_REGISTERED=device.registered
KAFKA_TOPIC_ENERGY_CONSUMPTION_RECORDED=energy.consumption.recorded
KAFKA_TOPIC_MONITORING_ALERT_CREATED=monitoring.alert.created
KAFKA_TOPIC_MONITORING_READING_PROCESSED=monitoring.reading.processed
KAFKA_TOPIC_ENERGY_READING_CREATED=energy.reading.created
DEVICE_SIMULATION_INTERVAL_SECONDS=3600
APP_HOST=0.0.0.0
API_BASE_PATH=/api/v1
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Legacy compatibility aliases (optional)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
MONGODB_URL=
APP_PORT=
APP_ENV=
